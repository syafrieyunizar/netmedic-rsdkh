{
  "manifest_version": 3,
  "name": "Netmedic RSDKH",
  "version": "1.8.3",
  "description": "Side panel mandiri RSDKH untuk Magic SOAP, Kronologi BPJS, dan modul khusus rumah sakit.",
  "permissions": ["sidePanel", "storage", "clipboardWrite"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://ai.sumopod.com/*",
    "https://aimurah.my.id/*",
    "https://ai.semutssh.com/*",
    "https://yvcqgwpfjoxhuyhxuiry.supabase.co/*",
    "https://rsudbalangan.com/*",
    "http://10.10.0.3/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Netmedic RSDKH",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://rsudbalangan.com/*", "http://10.10.0.3/*"],
      "js": ["hospital/rsdkh/erm.js", "hospital/rsdkh/prescription.js", "hospital/rsdkh/html2canvas.min.js", "hospital/rsdkh/lab-capture.js"],
      "css": ["hospital/rsdkh/erm.css", "hospital/rsdkh/prescription.css", "hospital/rsdkh/lab-capture.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["hospital/rsdkh/erm.css", "hospital/rsdkh/prescription.css", "hospital/rsdkh/lab-capture.css", "hospital/rsdkh/product-catalog.json", "hospital/rsdkh/product-aliases.json", "fonts/Manrope-Variable.ttf"],
      "matches": ["https://rsudbalangan.com/*", "http://10.10.0.3/*"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
