{
  "manifest_version": 3,
  "name": "Magic SOAP & Kronologi",
  "version": "1.0.0",
  "description": "Side panel mandiri untuk membuat Magic SOAP dan Kronologi BPJS.",
  "permissions": ["sidePanel", "storage", "clipboardWrite"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://ai.sumopod.com/*",
    "https://aimurah.my.id/*",
    "https://ai.semutssh.com/*",
    "https://yvcqgwpfjoxhuyhxuiry.supabase.co/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Magic SOAP & Kronologi",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
