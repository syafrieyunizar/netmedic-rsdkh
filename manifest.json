{
  "manifest_version": 3,
  "name": "Netmedic RSDKH",
  "version": "1.1.0",
  "description": "Side panel mandiri RSDKH untuk Magic SOAP, Kronologi BPJS, dan modul khusus rumah sakit.",
  "permissions": ["sidePanel", "storage", "clipboardWrite"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://ai.sumopod.com/*",
    "https://aimurah.my.id/*",
    "https://ai.semutssh.com/*",
    "https://yvcqgwpfjoxhuyhxuiry.supabase.co/*",
    "https://rsudbalangan.com/*",
    "http://10.10.0.3/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Netmedic RSDKH",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://rsudbalangan.com/*", "http://10.10.0.3/*"],
      "js": ["hospital/rsdkh/erm.js"],
      "css": ["hospital/rsdkh/erm.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["hospital/rsdkh/erm.css", "fonts/Manrope-Variable.ttf"],
      "matches": ["https://rsudbalangan.com/*", "http://10.10.0.3/*"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
